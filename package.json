  "author": "Klaas Leussink / hnldesign",
  "license": "MIT",
  "devDependencies": {
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
